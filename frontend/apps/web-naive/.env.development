# 端口号
VITE_PORT=5888

VITE_BASE=/

# 接口地址 — cadena vacía: todas las peticiones /api/** van al proxy de Vite.
# Con URL completa el browser hace fetch directo y el CORS depende del backend.
# VITE_GLOB_API_URL=http://192.168.20.145:8085
VITE_GLOB_API_URL=

# Destino del proxy dev (/api y /ws). Default 127.0.0.1:8085 (backend en la misma
# máquina). Descoméntalo y cámbialo si el backend corre en otro equipo de la red.
# VITE_PROXY_TARGET=http://192.168.20.145:8085
VITE_PROXY_TARGET=http://172.16.21.5:8085
# VITE_PROXY_TARGET=http://192.168.1.5:8085

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
