<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground del ícono adaptativo: usa el logo blanco (res/drawable-nodpi/logo_app.png)
  centrado con un inset para que quede dentro de la zona segura del ícono adaptativo
  (API 26+) y no lo recorte la máscara circular/squircle del launcher.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/logo_app"
    android:inset="20%" />
