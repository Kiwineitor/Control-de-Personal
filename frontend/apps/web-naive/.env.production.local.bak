# ─── Capacitor local build ──────────────────────────────────
# Sobreescribe .env.production SOLO en esta máquina.
# USO: pnpm build:capacitor  →  genera dist/ con esta URL.
# NO subir a producción (ya está en .gitignore: *.local).
#
# Cambia la IP/puerto si tu backend corre en otro host o puerto.
# Puerto por defecto: 7050 (application.properties)
# Puerto kevin profile: 8085 (application-kevin.properties)
# Puerto jhowill profile: 8085 (application-jhowill.properties)
VITE_GLOB_API_URL=http://192.168.1.9:7050
